# SwiftBalt (MediaHub / OmniDownloader) Configuration

# Application
SWIFTBALT_APP_NAME=SwiftBalt
SWIFTBALT_ENVIRONMENT=development
SWIFTBALT_DEBUG=true

# Server
SWIFTBALT_HOST=127.0.0.1
SWIFTBALT_PORT=8000

# Concurrency & Downloader
SWIFTBALT_MAX_CONCURRENT_DOWNLOADS=3
SWIFTBALT_DEFAULT_QUALITY=1080p
SWIFTBALT_DEFAULT_FORMAT=mp4
SWIFTBALT_AUTO_MERGE_STREAMS=true
SWIFTBALT_AUTO_CONVERT=false
SWIFTBALT_DELETE_TEMP_FILES=true
SWIFTBALT_REQUEST_TIMEOUT_SECONDS=45

# Security & SSRF Protection
SWIFTBALT_ALLOW_LOCAL_IP_IN_DEV=false
SWIFTBALT_ENABLE_RATE_LIMIT=true
SWIFTBALT_RATE_LIMIT_PER_MINUTE=120

# FFmpeg Paths (Auto-detected if in system PATH)
SWIFTBALT_FFMPEG_PATH=ffmpeg
SWIFTBALT_FFPROBE_PATH=ffprobe
