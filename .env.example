# SwiftBalt Configuration
APP_NAME=SwiftBalt
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=swiftbalt_secret_key_change_in_production

# Storage
DATA_DIR=data
DOWNLOAD_DIR=data/downloads
TEMP_DIR=data/temp
TORRENT_DIR=data/torrents
THUMBNAIL_DIR=data/thumbnails
METADATA_DIR=data/metadata
LOG_DIR=data/logs

# Database
DATABASE_URL=sqlite+aiosqlite:///data/swiftbalt.db

# Queue & Downloads
MAX_CONCURRENT_DOWNLOADS=3
MAX_FILE_SIZE_BYTES=10737418240  # 10 GB
RATE_LIMIT_PER_MINUTE=60
BANDWIDTH_LIMIT_KBPS=0  # 0 = unlimited

# Security
BLOCK_PRIVATE_IPS=true
ALLOW_DIRECT_DOWNLOADS=true

# FFmpeg
FFMPEG_PATH=
